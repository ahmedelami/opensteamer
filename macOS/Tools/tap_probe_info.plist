<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Minimal diagnostic bundle identity for tap_probe. Its single TCC usage string covers the
  temporary system-audio capture performed by the probe; the tool persists no captured PCM.
-->
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>tap_probe</string>
	<key>CFBundleIdentifier</key>
	<string>org.example.opensteamer.TapProbe</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>opensteamer Tap Probe</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>opensteamer captures system audio from this Mac so it can stream playback to your iPhone.</string>
</dict>
</plist>
