<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Reviewed production LaunchAgent. Keep the types and complete argument list exact. -->
<dict>
	<key>Label</key>
	<string>org.example.opensteamer.worldwide</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/opensteamer Host.app/Contents/MacOS/CaptureServer</string>
		<string>--worldwide</string>
		<string>--allow-remote-control</string>
		<string>--duration</string>
		<string>0</string>
		<string>--verbose</string>
		<string>--rendezvous-url</string>
		<string>wss://audiostreamer-rendezvous.elaminahmed03.workers.dev</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/var/tmp/opensteamer-worldwide-host.log</string>
	<key>StandardErrorPath</key>
	<string>/var/tmp/opensteamer-worldwide-host.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>OSLogRateLimit</key>
		<string>64</string>
	</dict>
</dict>
</plist>
