<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Per-user launchd template for the installed opensteamer Host bundle. It keeps worldwide
  availability running indefinitely, keeps remote control disabled, writes operational logs
  under /tmp/opensteamer, and lets launchd restart failures after a ten-second throttle.
  Pair interactively before loading this job. In a local configured copy, add --rendezvous-url
  and its WSS origin to ProgramArguments; deployment verification rejects endpoint overrides in
  launchd environment sections.
  Installation and Screen Recording grants are handled outside this template.
-->
<dict>
	<key>Label</key>
	<string>org.example.opensteamer.worldwide</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/opensteamer Host.app/Contents/MacOS/CaptureServer</string>
		<string>--worldwide</string>
		<string>--duration</string>
		<string>0</string>
		<string>--verbose</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/tmp/opensteamer/worldwide-host.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/opensteamer/worldwide-host.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>OSLogRateLimit</key>
		<string>64</string>
	</dict>
</dict>
</plist>
