# Bind to loopback behind a TLS reverse proxy. Use 0.0.0.0 only in a locked-down container/network.
HOST=127.0.0.1
PORT=8788
TRUST_PROXY_HOPS=0

INVITATION_TTL_SECONDS=300
HEARTBEAT_INTERVAL_MS=15000
PEER_TIMEOUT_MS=45000

RATE_WINDOW_SECONDS=60
IP_ATTEMPT_LIMIT=60
CHANNEL_ATTEMPT_LIMIT=20
IP_MESSAGE_LIMIT=600
CHANNEL_MESSAGE_LIMIT=300
MAX_ENVELOPE_BYTES=65536
MAX_MESSAGE_BYTES=90000

STUN_URLS=stun:stun.example.com:3478

# Self-hosted coturn REST mode. Inject TURN_SHARED_SECRET at runtime through the deployment
# secret manager; never put it in this file or source control.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=600
# TURN_SHARED_SECRET is injected at runtime.

# Alternatively, use Cloudflare Realtime TURN. It is mutually exclusive with TURN_URLS and
# TURN_SHARED_SECRET. Inject both values at runtime; never commit or log the API token.
# CLOUDFLARE_TURN_KEY_ID is injected at runtime.
# CLOUDFLARE_TURN_API_TOKEN is injected at runtime.
CLOUDFLARE_TURN_FETCH_TIMEOUT_MS=5000
